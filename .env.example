# Copie para .env e ajuste. O .env não é versionado.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrogestao
DB_USER=agrogestao
DB_PASSWORD=agrogestao_dev
DB_SCHEMA=public
DB_DRIVER_NAME=org.postgresql.Driver

# Administrador inicial, criado pela migration de dados iniciais na primeira subida.
ADMIN_LOGIN=admin
ADMIN_SENHA=admin_dev

# Chave que assina os tokens JWT (HS256). Obrigatória, sem valor padrão, mínimo de 32 caracteres.
# Gere uma com: openssl rand -base64 48
JWT_SEGREDO=
JWT_EXPIRACAO_MINUTOS=60
